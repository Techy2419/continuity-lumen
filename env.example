# Copy this file to .env and fill in your own real values.
# Never commit the actual .env file -- it's already in .gitignore.

# --- Google Cloud / ADK ---
GOOGLE_GENAI_USE_ENTERPRISE=1
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# --- Grafana Cloud (used by the Grafana MCP server) ---
GRAFANA_URL=https://your-stack.grafana.net
GRAFANA_SERVICE_ACCOUNT_TOKEN=your-service-account-token

# --- Lumen: Loki (logs) push credentials ---
LOKI_URL=https://logs-prod-XXX.grafana.net
LOKI_USER=your-loki-instance-id
LOKI_TOKEN=your-loki-access-policy-token
